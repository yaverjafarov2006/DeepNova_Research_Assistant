# Copy this to .env and fill in real values. DO NOT commit .env.

# ============ AI layer (provided module) ============
LLM_PROVIDER=anthropic          # anthropic | openai | gemini
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

WEB_SEARCH_PROVIDER=tavily      # tavily | serper | duckduckgo
TAVILY_API_KEY=                 # https://tavily.com — free 1000 req/month
# SERPER_API_KEY=               # https://serper.dev — free 2500 req
# (DuckDuckGo needs no key, but: pip install duckduckgo-search)

# ============ SE layer ============
# Logging
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false                  # true → one JSON object per log line

# Cache
CACHE_BACKEND=file              # file | memory
CACHE_DIR=./.cache
CACHE_TTL_SECONDS=86400         # 24 h
CACHE_ENABLED=true

# Concurrency
PER_SOURCE_TIMEOUT_SECONDS=10   # per-source timeout, not shared
TOTAL_TIMEOUT_SECONDS=45
MAX_SOURCES_PER_QUERY=3         # results per source
ENABLED_SOURCES=wikipedia,arxiv,web

# Retries (exponential backoff: 0.5s → 1s → 2s …, capped at RETRY_MAX_DELAY)
RETRY_ATTEMPTS=3
RETRY_INITIAL_DELAY=0.5
RETRY_MAX_DELAY=8.0

# Validation
MIN_QUESTION_LENGTH=5
MAX_QUESTION_LENGTH=500
